# Fishinity Pro — Feature Marketplace demo

# SQLite database (SQL, via Prisma). No external DB server needed.
DATABASE_URL="file:./dev.db"

# Google Gemini API key — powers the AI Feature Builder.
# Get one at https://aistudio.google.com/apikey. Without it, the builder falls
# back to a local template engine so the demo still runs end-to-end.
GEMINI_API_KEY=""

# Optional: override the Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL="gemini-2.0-flash"
